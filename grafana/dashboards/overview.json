{
  "uid": "overview",
  "title": "Service Overview - RED + SLO",
  "description": "Default incident view: Rate, Errors, Duration at the user-facing edge (BFF), plus dependency health. Provisioned as code.",
  "tags": ["sre", "red", "slo"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-15m", "to": "now" },
  "templating": { "list": [] },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Traffic - requests/s by status (BFF)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status_code) (rate(bff_http_requests_total[5m]))",
          "legendFormat": "{{status_code}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Error ratio % (BFF) vs SLO budget 0.1%",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": 0 },
              { "color": "orange", "value": 0.05 },
              { "color": "red", "value": 0.1 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * sum(rate(bff_http_requests_total{status_code=~\"5..\"}[5m])) / sum(rate(bff_http_requests_total[5m]))",
          "legendFormat": "error %"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Latency p50/p90/p99 (BFF)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.50, sum by (le) (rate(bff_http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.90, sum by (le) (rate(bff_http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "p90"
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(bff_http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Availability last hour vs SLO 99.9%",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 4, "x": 12, "y": 8 },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 3,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": 0 },
              { "color": "green", "value": 99.9 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * (1- sum(rate(bff_http_requests_total{status_code=~\"5..\"}[1h])) / sum(rate(bff_http_requests_total[1h])))"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Dependency error ratio: pricing (py)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 8 },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * sum(rate(pricing_http_requests_total{status_code=~\"5..\"}[5m])) / sum(rate(pricing_http_requests_total[5m]))",
          "legendFormat": "pricing error %"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Dependency error ratio: inventory (go)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 16 },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * sum(rate(inventory_http_requests_total{status_code=~\"5..\"}[5m])) / sum(rate(inventory_http_requests_total[5m]))",
          "legendFormat": "inventory error %"
        }
      ]
    },
    {
      "id": 7,
      "type": "logs",
      "title": "Errors from graded services (Loki)",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 8, "w": 16, "x": 8, "y": 16 },
      "targets": [
        {
          "refId": "A",
          "expr": "{service_name=~\"pricing-py|bff-node|inventory-go\"} |= \"ERROR\""
        }
      ]
    }
  ]
}
